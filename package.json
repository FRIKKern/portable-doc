{
  "name": "portable-doc",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "!packages/editor"],
  "scripts": {
    "roadmap": "node scripts/generate-roadmap.mjs",
    "heatmap": "node scripts/generate-heatmap.mjs",
    "timeline": "node scripts/readme-timeline.mjs",
    "alias-types": "node scripts/generate-alias-types.mjs",
    "docs:site": "node scripts/generate-docs-site.mjs",
    "sync": "node scripts/sync-from-barkpark.mjs",
    "test": "npm run react:build && node scripts/test-files.mjs --run",
    "check": "node scripts/check-links.mjs && node scripts/check-docs.mjs && node scripts/check-pack.mjs && npm run react:build && node scripts/test-files.mjs --run && npm run typecheck --workspace @portable-doc/react && npm run test --workspace @portable-doc/react",
    "react:build": "npm run build --workspace @portable-doc/react",
    "react:test": "npm run test --workspace @portable-doc/react",
    "react:pack": "node scripts/pack-react-release.mjs",
    "react:smoke": "node scripts/smoke-react-tarball.mjs",
    "code:pack": "node scripts/pack-code-release.mjs",
    "code:smoke": "node scripts/smoke-code-tarball.mjs"
  },
  "devDependencies": { "acorn": "8.19.0", "esbuild": "0.27.7", "typescript": "5.9.3" }
}
